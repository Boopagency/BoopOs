+      await correnteEmOnboarding(tx, projeto)
+
+      await switchIdentity(tx, asUser(CLIENTE_A))
+      await expect(
+        tx.query('select public.start_onboarding($1)', [projeto]),
+        'O CLIENTE ABRIU O PROPRIO ONBOARDING',
