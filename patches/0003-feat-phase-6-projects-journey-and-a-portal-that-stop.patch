+
+const BRANDING_V1: JourneyTemplate = {
+  key: 'branding.v1',
+  type: 'branding',
+  label: 'Marca',
+  stages: [
+    {
+      key: 'kickoff',
+      label: 'Início do projeto',
+      summary: 'Combinamos escopo, ritmo e por onde a gente começa.',
+    },
+    {
+      key: 'immersion',
+      label: 'Imersão',
+      summary: 'Entendemos o negócio, a história e o que a marca quer construir.',
