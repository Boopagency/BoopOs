+  MEMBRO_SEM_VINCULO,
+  PROJETO_HARTMANN,
+  PROJETO_VELMONT,
+  VELMONT,
+} from './support/fixtures'
+
+let db: Client
+
+beforeAll(async () => {
+  db = await connect()
+})
+
+afterAll(async () => {
+  await db?.end()
+})
