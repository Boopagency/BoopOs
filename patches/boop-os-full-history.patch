+  }
+
+  @keyframes boop-fade {
+    from {
+      opacity: 0;
+    }
+    to {
+      opacity: 1;
+    }
+  }
+
+  /* Deriva lentissima das nuvens. Amplitude pequena: atmosfera, nao animacao. */
+  @keyframes boop-drift {
+    0%,
+    100% {
+      transform: translate3d(0, 0, 0);
+    }
+    50% {
+      transform: translate3d(-1.5%, -1.8%, 0);
+    }
+  }
+
+  @keyframes boop-blink {
+    0%,
+    92%,
+    100% {
+      transform: scaleY(1);
+    }
+    95% {
+      transform: scaleY(0.06);
+    }
+  }
+
+  .rise {
+    animation: boop-rise var(--motion-emphasized) var(--ease-out) both;
+  }
+
+  .fade {
+    animation: boop-fade var(--motion-emphasized) var(--ease-standard) both;
+  }
+
+  /*
+   * Delays narrativos: headline primeiro, subtexto depois, acao por ultimo.
+   * Nunca aplicar em um controle que o usuario ja quer clicar.
+   */
+  .rise-1 {
+    animation-delay: 60ms;
+  }
+  .rise-2 {
+    animation-delay: 150ms;
+  }
+  .rise-3 {
+    animation-delay: 250ms;
+  }
+  .rise-4 {
+    animation-delay: 360ms;
+  }
+  .rise-5 {
+    animation-delay: 480ms;
+  }
+
+  .drift {
+    animation: boop-drift 34s ease-in-out infinite;
+  }
+  .drift-slow {
+    animation: boop-drift 52s ease-in-out infinite;
+  }
+
+  /* Zonas do grid editorial. */
+  .content {
+    width: 100%;
+    max-width: var(--content-max);
+    margin-inline: auto;
+    padding-inline: var(--gutter);
+  }
+
+  .content-wide {
+    width: 100%;
+    max-width: var(--wide-max);
+    margin-inline: auto;
+    padding-inline: var(--gutter);
+  }
+
+  .measure {
+    max-width: var(--measure);
+  }
+
+  /* Hairline funcional. Border so existe quando separa de verdade. */
+  .rule-top {
+    border-top: 1px solid var(--rule);
+  }
+  .rule-bottom {
+    border-bottom: 1px solid var(--rule);
+  }
+}
+
+/*
+ * Respeitar quem pediu menos movimento. Nenhuma informacao depende de motion:
+ * tudo permanece legivel e acessivel com as animacoes desligadas.
+ */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
   }
 }
