+
+    expect(container.querySelector('input[name="projectId"]')).toHaveValue(PROJETO.id)
+    expect(screen.getByLabelText(/início/i)).toHaveValue('2026-07-14')
+    expect(screen.getByLabelText(/fim previsto/i)).toBeInTheDocument()
+  })
