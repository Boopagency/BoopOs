+  whatHappened: string
+  whatWorked: { title: string; detail: string }[]
+  whatDidNot: { title: string; detail: string }[]
+  learnings: Insight[]
+  whatChanges: string[]
+}
+
+export interface ProjectFile {
+  id: string
+  name: string
+  category: FileCategory
+  kind: string
+  sizeLabel: string
+  addedOn: string
+}
