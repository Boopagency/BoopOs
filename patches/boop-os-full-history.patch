--- a/src/lib/supabase/server.ts
+++ b/src/lib/supabase/server.ts
@@ -1,27 +1,48 @@
 import 'server-only'
 
 import { createServerClient } from '@supabase/ssr'
+import { cookies } from 'next/headers'
 import { requireSupabaseEnv } from '@/config/env'
