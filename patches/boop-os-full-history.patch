+      summary: 'Você recebe os arquivos e o manual de uso da marca.',
+    },
+  ],
+}
+
+const AUTOMATION_V1: JourneyTemplate = {
+  key: 'automation.v1',
+  type: 'automation',
+  label: 'Automação',
+  stages: [
+    {
+      key: 'kickoff',
