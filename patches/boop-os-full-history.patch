+    })
+    expect(screen.queryByText('project.immutable_field')).not.toBeInTheDocument()
+  })
+
+  it('erro de campo: liga a mensagem ao campo por aria-describedby', async () => {
+    action.mockResolvedValue({
+      status: 'error',
+      code: 'input.invalid',
+      fieldErrors: { name: ['name_too_short'] },
