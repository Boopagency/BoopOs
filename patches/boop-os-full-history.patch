+  select string_agg(format('%s.%s:%s:%s', n.nspname, p.proname, p.prosecdef, md5(p.prosrc)),
+                    E'\n' order by n.nspname, p.proname) as s
+    from pg_proc p join pg_namespace n on n.oid = p.pronamespace
+   where n.nspname = 'app'
