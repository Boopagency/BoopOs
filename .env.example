# =============================================================================
# BOOP OS — variaveis de ambiente (EXEMPLO)
# =============================================================================
# Copie para `.env.local` e preencha o que a sua fase precisa.
# NUNCA commite `.env.local`. NUNCA coloque valores reais neste arquivo.
#
# Duas categorias, e a diferenca importa:
#
#   [REQUIRED NOW]        validada no boot. Tem default sensato para dev.
#   [FASE N]              validada SO quando a integracao e usada. Ausente,
#                         a aplicacao sobe e funciona normalmente.
#
# Ou seja: `pnpm dev` e `pnpm build` funcionam com este arquivo inteiro vazio.
#
# Regra de prefixo:
#   NEXT_PUBLIC_*  -> vai para o browser. So o que pode ser publico.
#   sem prefixo    -> server-side apenas. Nunca em Client Component.
#
# Ver docs/deployment.md (matriz de ambientes) e docs/security.md (secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacao — [REQUIRED NOW]
# -----------------------------------------------------------------------------
# URL publica da aplicacao. Default em dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# development | preview | production. Distingue preview de producao, o que
# NODE_ENV nao faz (nos dois ele vale "production"). Usado a partir da FASE 5
# para impedir que e-mail de teste alcance cliente real.
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase — [FASE 3]
# -----------------------------------------------------------------------------
# Projeto local (`supabase start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Chave anonima / publishable. E publica por design; a protecao real e a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENCAO — SEGREDO CRITICO.
# Ignora TODA a RLS. Lida exclusivamente por src/lib/supabase/admin.ts.
# NUNCA prefixe com NEXT_PUBLIC_. NUNCA use em Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Conexao Postgres direta. Usada APENAS pela suite `pnpm test:rls`, que roda
# contra Postgres de verdade. Nao deve existir em preview nem em producao.
# Vazia, a suite usa o default local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# — a mesma porta do `supabase start` e do plano B sem Docker
# (scripts/db/local-postgres.sh). Ver docs/database.md.
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# E-mail (Resend) — [FASE 5]
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# Remetente verificado no dominio da Boop. Ex.: "Boop <os@boop.com.br>"
EMAIL_FROM=

# Em development, `true` imprime o e-mail no log em vez de enviar.
EMAIL_DRY_RUN=true

# -----------------------------------------------------------------------------
# Notion — [FASE 17]
# -----------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_CLIENTS_DATABASE_ID=

# -----------------------------------------------------------------------------
# Operacional — [FASE 18]
# -----------------------------------------------------------------------------
# Segredo compartilhado exigido no header de rotas de cron/webhook interno.
CRON_SECRET=
