# =============================================================================
# BOOP OS — variáveis de ambiente (EXEMPLO)
# =============================================================================
# Copie para `.env.local` e preencha com os valores do ambiente correspondente.
# NUNCA commite `.env.local`. NUNCA coloque valores reais neste arquivo.
#
# Regra de ouro:
#   NEXT_PUBLIC_*  -> vai para o browser. Só coloque aqui o que pode ser público.
#   Sem prefixo    -> server-side apenas. Nunca importe em Client Component.
#
# Ver: docs/deployment.md (matriz de ambientes) e docs/security.md (secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# URL pública da aplicação. Usada para montar links de e-mail e o redirect
# do Magic Link. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# development | preview | production
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Projeto local (`supabase start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima / publishable. É pública por design; a proteção real é a RLS.
# Formatos aceitos: JWT legado (eyJ...) ou o novo `sb_publishable_...`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO — SEGREDO CRÍTICO.
# Ignora TODA a RLS. Só pode ser lida em código server-side, exclusivamente
# através de `src/lib/supabase/admin.ts` (que importa `server-only`).
# NUNCA prefixe com NEXT_PUBLIC_. NUNCA use em Client Component.
# Formatos aceitos: JWT legado (eyJ...) ou o novo `sb_secret_...`.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão Postgres direta. Usada APENAS pelos testes de RLS (tests/rls) contra
# o Supabase local. Não deve existir em preview nem em produção.
# Local padrão: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# E-mail (Resend)
# -----------------------------------------------------------------------------
# E-mails de produto (aprovação pendente, estratégia pronta, review publicado)
# saem pela API do Resend. E-mails de autenticação saem pelo Supabase, que usa
# o Resend como SMTP customizado. Ver docs/integrations.md.
RESEND_API_KEY=

# Remetente verificado no domínio da Boop. Ex.: "Boop <os@boop.com.br>"
EMAIL_FROM=

# Cópia interna de notificações operacionais (opcional).
EMAIL_INTERNAL_INBOX=

# Em development, `true` imprime o e-mail no log em vez de enviar.
EMAIL_DRY_RUN=true

# -----------------------------------------------------------------------------
# Notion — FASE 17. Deixe vazio até lá.
# A aplicação DEVE funcionar normalmente com estas variáveis ausentes.
# -----------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_CLIENTS_DATABASE_ID=

# -----------------------------------------------------------------------------
# Operacional
# -----------------------------------------------------------------------------
# Segredo compartilhado exigido no header de rotas de cron/webhook interno.
CRON_SECRET=
